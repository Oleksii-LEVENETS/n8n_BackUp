    {
      "parameters": {
        "jsCode": "const item = JSON.parse(JSON.stringify($input.item));\n\n// Check if we have binary data\nif (item.binary && item.binary.data) {\n  // Fix the MIME type\n  item.binary.data.mimeType = 'image/jpeg';\n  \n  // If the file has a .jpg or .jpeg extension\n  if (item.binary.data.fileName.endsWith('.jpg') || item.binary.data.fileName.endsWith('.jpeg')) {\n    item.binary.data.mimeType = 'image/jpeg';\n  }\n  // If the file has a .png extension\n  else if (item.binary.data.fileName.endsWith('.png')) {\n    item.binary.data.mimeType = 'image/png';\n  }\n}\n\nreturn {json: item.json, binary: item.binary};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
