        "jsCode": "// Get the Gladia API response from the previous node\nconst gladiaResult = $input.first().json;\n\n// Extract the transcript text safely\nlet transcript = \"\";\n\n// Check if transcription data exists and has the expected structure\nif (gladiaResult && gladiaResult.result && gladiaResult.result.transcription) {\n  if (gladiaResult.result.transcription.full_transcript) {\n    transcript = gladiaResult.result.transcription.full_transcript;\n  } else {\n    transcript = \"No transcription available\";\n  }\n} else {\n  transcript = \"No transcription data found\";\n}\n\n// Get original message info from the Telegram node (assuming it's the first node)\nconst telegramMessage = $('Telegram Trigger').first().json.message;\n\nreturn {\n  json: {\n    transcript: transcript\n  }\n};"
      },
