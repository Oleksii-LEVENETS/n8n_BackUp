    {
      "parameters": {
        "jsCode": "// Handle basic commands\nconst text = $input.item.json.text;\nconst chatId = $input.item.json.chatId;\n\nlet response = '';\n\nswitch(text.toLowerCase()) {\n  case '/start':\n    response = '🇳🇴 Welcome to Simple Norsk Cards!\\n\\nSend me Ukrainian words and I\\'ll translate them to Norwegian.\\n\\nCommands:\\n/help - Show this help\\n/test - Test the bot';\n    break;\n    \n  case '/help':\n    response = '📚 How to use:\\n\\n1. Send Ukrainian words\\n2. Get Norwegian translation\\n3. Practice and learn!\\n\\nExample: Send \"собака\" to get Norwegian translation.';\n    break;\n    \n  case '/test':\n    response = '✅ Bot is working! Send \"собака\" to test translation.';\n    break;\n    \n  default:\n    response = '❓ Unknown command. Use /help for instructions.';\n}\n\nreturn {\n  json: {\n    chatId: chatId,\n    response: response\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        720
      ],
      "id": "f755faf1-d40f-475c-8618-3e4edae7bab4",
