    {
      "parameters": {
        "jsCode": "const message = $input.item.json.message;\nconst text = message.text || '';\nconst userId = message.from.id;\nconst userName = `${message.from.first_name} ${message.from.last_name || ''}`.trim();\n\n// Enhanced input detection\nconst inputType = {\n  isCommand: text.startsWith('/'),\n  isPhoto: message.photo !== undefined,\n  isVoice: message.voice !== undefined,\n  isText: text && !text.startsWith('/'),\n  isBatch: text.includes(',') || text.includes(';') || text.includes('\\n')\n};\n\n// Command parsing\nlet command = null;\nif (inputType.isCommand) {\n  command = text.split(' ')[0].toLowerCase();\n}\n\n// User context setup\nconst userContext = {\n  id: userId,\n  name: userName,\n  username: message.from.username || '',\n  chatId: message.chat.id,\n  timestamp: new Date().toISOString()\n};\n\nreturn {\n  json: {\n    ...userContext,\n    inputType,\n    command,\n    originalMessage: message,\n    processingId: `proc_${userId}_${Date.now()}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        -720
      ],
      "id": "8992ac4d-51d8-408e-9036-9c84e31c3391",
      "name": "Smart Input Analyzer"
    },
    {
      "parameters": {
        "jsCode": "const command = $input.item.json.command;\nconst userId = $input.item.json.id;\nconst chatId = $input.item.json.chatId;\n\n// Enhanced command handling\nswitch(command) {\n  case '/start':\n    return {\n      json: {\n        chatId,\n        response: '🇳🇴 Welcome to Enhanced Norsk Cards Bot!\\n\\n📸 Send a photo - I\\'ll identify objects\\n📝 Send Ukrainian text - I\\'ll translate to Norwegian\\n🎤 Send voice message - I\\'ll process speech\\n📚 Use commands:\\n/stats - Your learning progress\\n/review - Practice words\\n/help - Full instructions\\n/settings - Preferences',\n        action: 'send_message'\n      }\n    };\n    \n  case '/help':\n    return {\n      json: {\n        chatId,\n        response: '🔧 Enhanced Features:\\n\\n📸 Photo Recognition\\n📝 Text Translation (Ukrainian→Norwegian)\\n🎤 Voice Processing\\n📊 Progress Tracking\\n🔄 Batch Processing (comma-separated)\\n📋 IPA Transcription\\n💾 Auto-save to Google Sheets\\n\\n🎯 Commands:\\n/stats - Learning statistics\\n/review - Practice session\\n/settings - User preferences',\n        action: 'send_message'\n      }\n    };\n    \n  case '/stats':\n    return {\n      json: {\n        chatId,\n        userId,\n        action: 'get_stats'\n      }\n    };\n    \n  case '/review':\n    return {\n      json: {\n        chatId,\n        userId,\n        action: 'get_review'\n      }\n    };\n    \n  case '/settings':\n    return {\n      json: {\n        chatId,\n        response: '⚙️ Settings:\\n\\n🔊 Audio enabled: Yes\\n📝 IPA transcription: Yes\\n🎯 Difficulty level: Intermediate\\n📊 Progress tracking: Enabled\\n\\nUse inline buttons to modify settings.',\n        action: 'send_message'\n      }\n    };\n    \n  default:\n    return {\n      json: {\n        chatId,\n        response: '❓ Unknown command. Use /help for available commands.',\n        action: 'send_message'\n      }\n    };\n}"
      },
