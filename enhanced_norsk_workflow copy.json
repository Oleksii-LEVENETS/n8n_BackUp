    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are a Norwegian language learning assistant. Translate Ukrainian words to Norwegian and provide learning information.\n\nFor the Ukrainian word provided, return ONLY valid JSON in this exact format:\n{\n  \"word_no\": \"Norwegian translation\",\n  \"word_no_ipa\": \"IPA pronunciation\",\n  \"word_en\": \"English translation\",\n  \"word_uk\": \"Original Ukrainian word\",\n  \"examples\": [\"Example 1 in Norwegian\", \"Example 2 in Norwegian\", \"Example 3 in Norwegian\"],\n  \"difficulty\": \"beginner or intermediate or advanced\"\n}",
        "messages": {
          "messageValues": [
            {
              "message": "={{ $('Telegram Trigger').item.json.message.text }}"
            }
          ]
        }
      },
