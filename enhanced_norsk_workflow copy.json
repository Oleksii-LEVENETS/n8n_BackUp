    {
      "parameters": {
        "jsCode": "// Enhanced response processing with error handling\ntry {\n  const response = $input.item.json.response || $input.item.json.text;\n  let data;\n  \n  // Robust JSON parsing\n  try {\n    data = JSON.parse(response);\n  } catch (e) {\n    const jsonMatch = response.match(/{[\\s\\S]*?}/);\n    if (jsonMatch) {\n      data = JSON.parse(jsonMatch[0]);\n    } else {\n      throw new Error('No valid JSON found in response');\n    }\n  }\n  \n  // Enhanced validation\n  const requiredFields = ['word_no', 'word_en', 'word_uk', 'examples'];\n  const missingFields = requiredFields.filter(field => !data[field]);\n  \n  if (missingFields.length > 0) {\n    throw new Error(`Missing required fields: ${missingFields.join(', ')}`);\n  }\n  \n  // Get previous node data safely\n  const inputAnalyzer = $('Smart Input Analyzer').item.json;\n  \n  // Enrich data with metadata\n  const enrichedData = {\n    ...data,\n    processingId: inputAnalyzer.processingId,\n    userId: inputAnalyzer.id,\n    userName: inputAnalyzer.name,\n    chatId: inputAnalyzer.chatId,\n    inputType: inputAnalyzer.inputType,\n    timestamp: new Date().toISOString(),\n    confidence: 'high',\n    source: 'primary_llm'\n  };\n  \n  return { json: enrichedData };\n  \n} catch (error) {\n  const inputAnalyzer = $('Smart Input Analyzer').item.json;\n  return {\n    json: {\n      error: true,\n      errorMessage: error.message,\n      processingId: inputAnalyzer.processingId,\n      chatId: inputAnalyzer.chatId,\n      fallbackNeeded: true\n    }\n  };\n}"
      },
