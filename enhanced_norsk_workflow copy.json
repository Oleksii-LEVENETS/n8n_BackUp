    {
      "parameters": {
        "jsCode": "// Process translation response\ntry {\n  const response = $input.item.json.response || $input.item.json.text;\n  const chatId = $('Simple Input Processor').item.json.chatId;\n  \n  // Try to parse JSON\n  let data;\n  try {\n    data = JSON.parse(response);\n  } catch (e) {\n    // If direct parsing fails, try to extract JSON from response\n    const jsonMatch = response.match(/{[\\s\\S]*?}/);\n    if (jsonMatch) {\n      data = JSON.parse(jsonMatch[0]);\n    } else {\n      throw new Error('No valid JSON found');\n    }\n  }\n  \n  // Validate required fields\n  if (!data.word_no || !data.word_en || !data.word_uk) {\n    throw new Error('Missing required translation fields');\n  }\n  \n  return {\n    json: {\n      ...data,\n      chatId: chatId,\n      success: true\n    }\n  };\n  \n} catch (error) {\n  return {\n    json: {\n      chatId: $('Simple Input Processor').item.json.chatId,\n      error: true,\n      errorMessage: error.message,\n      response: '❌ Translation failed. Please try again with a single Ukrainian word.'\n    }\n  };\n}"
      },
